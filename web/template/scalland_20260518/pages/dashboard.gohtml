{{define "body_classes"}}bg-background text-on-background font-body-md min-h-screen selection:bg-secondary selection:text-on-secondary{{end}}
{{define "header_block"}}{{end}}
{{define "footer_block"}}{{end}}
{{define "content"}}
<!-- SideNavBar Component -->
<aside id="dashboard-sidebar" class="fixed left-0 top-0 h-screen flex flex-col p-md z-50 bg-primary-container dark:bg-inverse-surface text-on-primary-container dark:text-inverse-on-surface shadow-lg w-64 border-r border-outline-variant/10 transform -translate-x-full md:translate-x-0 transition-transform duration-300 overflow-y-auto overflow-x-hidden">
<button id="close-sidebar-btn" class="md:hidden absolute top-4 right-4 p-1 text-on-primary-container/70 dark:text-inverse-on-surface/70 hover:bg-white/10 rounded-full flex items-center justify-center transition-colors z-50">
<span class="material-symbols-outlined">close</span>
</button>
<!-- Header -->
<div class="flex items-center gap-sm mb-lg px-base">
<div class="w-10 h-10 rounded-full bg-surface-container-high overflow-hidden shrink-0 border-2 border-secondary/20">
<img alt="Consultant Profile" class="w-full h-full object-cover" data-alt="A professional headshot of an enterprise consultant. The portrait features a confident individual in modern corporate attire against a clean, softly lit office background. High-key lighting ensures a bright, premium aesthetic. The color palette incorporates deep navy and subtle electric blue tones in the wardrobe, aligning with a trustworthy, modern corporate identity." src="./static/img/dashboard_profile.jpg"/>
</div>
<div class="flex flex-col">
<img alt="Scalland" class="h-8 w-auto object-contain mb-1 dark:hidden" src="./static/img/scalland_final_logo_dark.svg"/>
<img alt="Scalland" class="h-8 w-auto object-contain mb-1 hidden dark:block" src="./static/img/scalland_final_logo.svg"/>
<p class="font-body-sm text-body-sm text-on-primary-container/70">Enterprise View</p>
</div>
</div>
<!-- Navigation Links -->
<nav class="flex-1 flex flex-col gap-xs">
<a class="bg-secondary text-on-secondary rounded-lg font-label-lg text-label-lg px-4 py-3 flex items-center gap-sm translate-x-1 duration-200 shadow-sm" href="#">
<span class="material-symbols-outlined icon-fill">dashboard</span>
                Overview
            </a>
<a class="text-on-primary-container/70 hover:bg-white/10 hover:text-on-primary-container rounded-lg font-label-lg text-label-lg px-4 py-3 flex items-center gap-sm hover:bg-secondary-container/20 transition-all" href="#">
<span class="material-symbols-outlined">monitoring</span>
                Analytics
            </a>
<a class="text-on-primary-container/70 hover:bg-white/10 hover:text-on-primary-container rounded-lg font-label-lg text-label-lg px-4 py-3 flex items-center gap-sm hover:bg-secondary-container/20 transition-all" href="#">
<span class="material-symbols-outlined">settings</span>
                Settings
            </a>
<a class="text-on-primary-container/70 hover:bg-white/10 hover:text-on-primary-container rounded-lg font-label-lg text-label-lg px-4 py-3 flex items-center gap-sm hover:bg-secondary-container/20 transition-all" href="#">
<span class="material-symbols-outlined">help</span>
                Support
            </a>
</nav>
<!-- Action Bar (Moved from Header) -->
<div class="mt-md flex flex-col gap-sm px-base border-t border-white/10 pt-md">
    <span class="flex items-center justify-center gap-2 bg-surface-container/20 dark:bg-black/5 px-4 py-2 rounded-lg font-label-sm text-label-sm text-on-primary-container dark:text-inverse-on-surface w-full">
        <span class="w-2 h-2 rounded-full bg-secondary"></span>
        System Optimal
    </span>
    <button class="bg-secondary text-on-secondary rounded-lg font-label-lg text-label-lg px-4 py-3 hover:opacity-90 transition-colors flex items-center justify-center gap-2 shadow-sm w-full">
        <span class="material-symbols-outlined text-sm">download</span>
        Export Report
    </button>
    <button id="theme-toggle" class="bg-surface-container-high/20 dark:bg-black/5 hover:bg-white/10 transition-colors rounded-lg font-label-lg text-label-lg px-4 py-3 text-on-primary-container dark:text-inverse-on-surface flex items-center justify-center gap-2 shadow-sm w-full">
        <span class="material-symbols-outlined" id="theme-icon">dark_mode</span>
        Toggle Theme
    </button>
</div>
<!-- Footer Links -->
<div class="mt-auto flex flex-col gap-xs border-t border-white/10 pt-md">
<a class="text-on-primary-container/70 hover:bg-white/10 hover:text-on-primary-container rounded-lg font-label-lg text-label-lg px-4 py-3 flex items-center gap-sm hover:bg-secondary-container/20 transition-all" href="#">
<span class="material-symbols-outlined">description</span>
                Documentation
            </a>
<!-- CTA -->
<button class="mt-sm bg-secondary text-on-secondary rounded-lg font-label-lg text-label-lg px-4 py-3 hover:opacity-90 transition-colors flex items-center justify-center gap-sm shadow-sm w-full" onclick="logout()">
<span class="material-symbols-outlined">logout</span>
                Logout
            </button>
</div>
</aside>
<!-- Main Content Canvas -->
<main class="flex-1 md:ml-64 min-h-screen p-margin-mobile md:p-margin-desktop">
    <div class="max-w-[1440px]">
<!-- Page Header -->
<header class="flex flex-col md:flex-row justify-between items-start md:items-end mb-lg gap-4">
<div class="flex items-start gap-4">
<button id="mobile-sidebar-toggle" class="md:hidden mt-1 p-2 text-on-surface bg-surface-container-low hover:bg-surface-container-high rounded-lg flex items-center justify-center transition-colors">
<span class="material-symbols-outlined">menu</span>
</button>
<div>
<h2 class="font-display-lg-mobile text-display-lg-mobile text-on-surface mb-2">Enterprise Overview</h2>
<p class="font-body-lg text-body-lg text-on-surface-variant">System performance and active architectural deployments.</p>
</div>
</div>
</header>
<!-- Bento Grid Layout -->
<div class="grid grid-cols-12 gap-gutter">
<!-- Active Projects (Enterprise Card) -->
<div class="col-span-12 md:col-span-4 bg-surface rounded-lg shadow-level-1 p-lg flex flex-col">
<div class="flex justify-between items-start mb-md">
<h3 class="font-headline-md text-headline-md text-on-surface">Active Projects</h3>
<div class="p-2 bg-secondary/10 text-secondary rounded-lg">
<span class="material-symbols-outlined">account_tree</span>
</div>
</div>
<div class="flex-1 flex flex-col justify-center">
<div class="font-display-lg text-display-lg text-primary mb-2">142</div>
<div class="flex items-center gap-2 text-secondary font-label-sm text-label-sm">
<span class="material-symbols-outlined text-[16px]">trending_up</span>
<span class="">+12% from last quarter</span>
</div>
</div>
<div class="mt-md h-16 w-full bg-surface-container-low rounded overflow-hidden relative">
<!-- Abstract representation of a chart -->
<div class="absolute bottom-0 left-0 w-1/4 h-1/3 bg-primary-container/20 rounded-t"></div>
<div class="absolute bottom-0 left-1/4 w-1/4 h-2/3 bg-primary-container/40 rounded-t"></div>
<div class="absolute bottom-0 left-2/4 w-1/4 h-1/2 bg-primary-container/60 rounded-t"></div>
<div class="absolute bottom-0 left-3/4 w-1/4 h-full bg-secondary rounded-t"></div>
</div>
</div>
<!-- Cloud Health (Feature Card with Accent) -->
<div class="col-span-12 md:col-span-8 bg-surface rounded-lg shadow-level-1 p-lg border-t-4 border-secondary flex flex-col">
<div class="flex justify-between items-center mb-md border-b border-outline-variant/20 pb-4">
<h3 class="font-headline-md text-headline-md text-on-surface">Infrastructure Health</h3>
<span class="bg-surface-container-high px-3 py-1 rounded text-on-surface-variant font-label-sm text-label-sm">Global Regions</span>
</div>
<div class="grid grid-cols-3 gap-gutter flex-1 items-center">
<!-- Uptime Metric -->
<div class="flex flex-col items-center justify-center border-r border-outline-variant/20">
<div class="relative w-32 h-32 flex items-center justify-center">
<svg class="w-full h-full transform -rotate-90" viewbox="0 0 100 100">
<circle cx="50" cy="50" fill="none" r="45" stroke="#f3f3f3" stroke-width="8"></circle>
<circle class="transition-all duration-1000" cx="50" cy="50" fill="none" r="45" stroke="#007BFF" stroke-dasharray="283" stroke-dashoffset="14" stroke-width="8"></circle>
</svg>
<div class="absolute flex flex-col items-center">
<span class="font-headline-md text-headline-md text-primary">99.9%</span>
<span class="font-label-sm text-label-sm text-on-surface-variant">Uptime</span>
</div>
</div>
</div>
<!-- Status List -->
<div class="col-span-2 pl-md flex flex-col justify-center gap-sm">
<div class="flex justify-between items-center bg-surface-container-low p-3 rounded">
<span class="font-label-lg text-label-lg text-on-surface">US-East-1 (Primary)</span>
<span class="bg-secondary/10 text-secondary px-2 py-1 rounded font-label-sm text-label-sm flex items-center gap-1">
<span class="w-1.5 h-1.5 rounded-full bg-secondary"></span> Operational
                                </span>
</div>
<div class="flex justify-between items-center bg-surface-container-low p-3 rounded">
<span class="font-label-lg text-label-lg text-on-surface">EU-Central-1 (Failover)</span>
<span class="bg-secondary/10 text-secondary px-2 py-1 rounded font-label-sm text-label-sm flex items-center gap-1">
<span class="w-1.5 h-1.5 rounded-full bg-secondary"></span> Operational
                                </span>
</div>
<div class="flex justify-between items-center bg-surface-container-low p-3 rounded">
<span class="font-label-lg text-label-lg text-on-surface">AP-South-1 (Edge)</span>
<span class="bg-surface-tint/10 text-surface-tint px-2 py-1 rounded font-label-sm text-label-sm flex items-center gap-1">
<span class="w-1.5 h-1.5 rounded-full bg-surface-tint"></span> Syncing
                                </span>
</div>
</div>
</div>
</div>
<!-- Brand Reach Map -->
<div class="col-span-12 md:col-span-8 bg-surface rounded-lg shadow-level-1 p-0 overflow-hidden relative min-h-[300px]">
<div class="absolute top-lg left-lg z-10 bg-surface/80 backdrop-blur-md p-4 rounded shadow-level-2 border border-white/20">
<h3 class="font-headline-md text-headline-md text-on-surface mb-1">Global Brand Reach</h3>
<p class="font-body-sm text-body-sm text-on-surface-variant">Active nodes across major tech hubs.</p>
</div>
<div class="w-full h-full bg-primary-container relative">
<!-- Simulated Map Background Image via div -->
<div class="absolute inset-0 bg-cover bg-center opacity-40 mix-blend-luminosity" data-alt="A highly stylized digital map of the world rendered in an enterprise aesthetic. The map features a deep navy blue background with continents outlined in glowing, precise electric blue lines. Connecting arcs of light span across regions, symbolizing global digital connectivity and data transfer. The overall mood is advanced, secure, and professional, reflecting a high-tier corporate dashboard visualization." style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuBLoEj5-TBGrfmLu6fBVSkEhg-m7_kVU1SMAZXx9bqgadi8nzlFIAuTcbckYomkuPHaXwmWO7VcoYootEvJ23-btMS4fW9FTb2H-3DURMQXoLAf0x5YXDthRRqQ_o8jA03qMd4qZxloByhxpnzW0YVhJ5UDyfP8XoFY7vrjr71jpaDawVaLi7LKAUVaxyXUb-wTfxwTe9GpTAgNzA4-8SU2dnodqxMFbFMFLxl7s-h9WoPlupqYUaj9joLNgf358sjBGnmJZ2-78nY');">
</div>
<!-- Map Nodes overlay -->
<div class="absolute top-1/3 left-1/4 w-3 h-3 bg-secondary rounded-full shadow-[0_0_15px_rgba(0,123,255,0.8)]"></div>
<div class="absolute top-1/2 left-1/2 w-4 h-4 bg-secondary rounded-full shadow-[0_0_20px_rgba(0,123,255,0.8)] border-2 border-white"></div>
<div class="absolute top-1/4 left-3/4 w-2 h-2 bg-primary-fixed-dim rounded-full"></div>
</div>
</div>
<!-- Quick Settings Panel -->
<div class="col-span-12 md:col-span-4 bg-surface rounded-lg shadow-level-1 p-lg flex flex-col">
<h3 class="font-headline-md text-headline-md text-on-surface mb-md">System Preferences</h3>
<div class="flex flex-col gap-md flex-1">
<!-- Setting Item -->
<div class="flex items-center justify-between">
<div>
<h4 class="font-label-lg text-label-lg text-on-surface">Auto-Scaling</h4>
<p class="font-body-sm text-body-sm text-on-surface-variant">Manage elastic resources</p>
</div>
<button class="w-12 h-6 bg-secondary rounded-full relative transition-colors focus:outline-none focus:ring-2 focus:ring-secondary focus:ring-offset-2">
<span class="absolute right-1 top-1 w-4 h-4 bg-white rounded-full transition-transform"></span>
</button>
</div>
<div class="w-full h-px bg-outline-variant/20"></div>
<!-- Setting Item -->
<div class="flex items-center justify-between">
<div>
<h4 class="font-label-lg text-label-lg text-on-surface">Anomaly Alerts</h4>
<p class="font-body-sm text-body-sm text-on-surface-variant">Notify on variance &gt; 5%</p>
</div>
<button class="w-12 h-6 bg-surface-container-high rounded-full relative transition-colors focus:outline-none focus:ring-2 focus:ring-secondary focus:ring-offset-2">
<span class="absolute left-1 top-1 w-4 h-4 bg-outline rounded-full transition-transform"></span>
</button>
</div>
<div class="w-full h-px bg-outline-variant/20"></div>
<!-- Setting Item -->
<div class="flex items-center justify-between">
<div>
<h4 class="font-label-lg text-label-lg text-on-surface">Data Sync Rate</h4>
<p class="font-body-sm text-body-sm text-on-surface-variant">Current: Real-time</p>
</div>
<select class="bg-surface-container-low border border-outline-variant rounded text-label-sm font-label-sm py-1 px-2 text-on-surface focus:border-secondary focus:ring-1 focus:ring-secondary outline-none">
<option>Real-time</option>
<option>Hourly</option>
<option>Daily</option>
</select>
</div>
</div>
<button class="mt-md w-full bg-transparent border border-outline-variant text-on-surface-variant hover:bg-surface-container-low rounded font-label-sm text-label-sm py-2 transition-colors">
                        Advanced Settings
                    </button>
</div>
</div>
</div>
</main>
{{end}}
{{define "scripts"}}
<script>
  if (localStorage.getItem('color-theme') === 'dark' || (!('color-theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) { document.documentElement.classList.add('dark'); } else { document.documentElement.classList.remove('dark'); }
</script>

<script>
    const themeToggleBtn = document.getElementById('theme-toggle');
    const themeIcon = document.getElementById('theme-icon');
    if (themeToggleBtn && themeIcon) {
        if (document.documentElement.classList.contains('dark')) {
            themeIcon.textContent = 'light_mode';
        } else {
            themeIcon.textContent = 'dark_mode';
        }
        themeToggleBtn.addEventListener('click', function() {
            if (document.documentElement.classList.contains('dark')) {
                document.documentElement.classList.remove('dark');
                localStorage.setItem('color-theme', 'light');
                themeIcon.textContent = 'dark_mode';
            } else {
                document.documentElement.classList.add('dark');
                localStorage.setItem('color-theme', 'dark');
                themeIcon.textContent = 'light_mode';
            }
        });
    }
</script>
<script>
    const sidebarToggle = document.getElementById('mobile-sidebar-toggle');
    const sidebar = document.getElementById('dashboard-sidebar');
    const closeSidebarBtn = document.getElementById('close-sidebar-btn');
    if (sidebarToggle && sidebar) {
        sidebarToggle.addEventListener('click', () => {
            sidebar.classList.remove('-translate-x-full');
        });
    }
    if (closeSidebarBtn && sidebar) {
        closeSidebarBtn.addEventListener('click', () => {
            sidebar.classList.add('-translate-x-full');
        });
    }

    async function logout() {
        try {
            await fetch('/api/v1/auth/logout', { method: 'POST' });
            window.location.href = '/login';
        } catch (e) {
            console.error('Logout failed:', e);
            window.location.href = '/login';
        }
    }
</script>
{{end}}
