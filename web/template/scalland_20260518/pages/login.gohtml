{{define "body_classes"}}bg-background min-h-screen flex flex-col relative overflow-x-hidden overflow-y-auto text-on-background{{end}}
{{define "header_block"}}{{template "navbar" .}}{{end}}
{{define "content"}}
<main class="flex-grow flex flex-col items-center justify-center px-margin-mobile pt-32 pb-12 md:pt-40 md:pb-16 w-full relative z-10">
<!-- Ambient background gradient -->

<div class="absolute inset-0 bg-gradient-to-br from-surface to-surface-variant opacity-50 z-0"></div>
<div class="absolute top-[-20%] right-[-10%] w-[600px] h-[600px] rounded-full bg-secondary/5 blur-[120px] z-0 pointer-events-none"></div>
<div class="absolute bottom-[-20%] left-[-10%] w-[500px] h-[500px] rounded-full bg-primary-container/5 blur-[100px] z-0 pointer-events-none"></div>
<!-- Login Container -->
<div class="glass-panel level-1-shadow rounded-xl w-full max-w-md p-lg relative z-10 border border-outline-variant/30">
<!-- Header -->
<div class="text-center mb-xl">
<h1 class="font-headline-lg text-headline-lg text-primary mb-sm">
<img alt="Scalland" class="h-10 mx-auto dark:hidden" src="./static/img/scalland_final_logo.svg"/>
<img alt="Scalland" class="h-10 mx-auto hidden dark:block" src="./static/img/scalland_final_logo_dark.svg"/>
</h1>
<p class="font-body-sm text-body-sm text-on-surface-variant">Secure Enterprise Access</p>
</div>
<!-- Form State: Email Entry -->
<form class="flex flex-col gap-md" id="login-form" onsubmit="return false;">
<div class="flex flex-col gap-xs" id="email-container">
<label class="font-label-sm text-label-sm text-on-surface-variant" for="email">Email Address</label>
<div class="relative">
<div class="absolute inset-y-0 left-0 pl-sm flex items-center pointer-events-none">
<span class="material-symbols-outlined text-outline">mail</span>
</div>
<input class="w-full pl-xl pr-sm py-sm rounded border border-outline-variant bg-surface-container-lowest focus:border-secondary focus:ring-2 focus:ring-secondary/20 font-body-md text-body-md text-on-surface transition-colors" id="email" name="email" placeholder="name@company.com" required="" type="email"/>
</div>
<button id="send-otp-btn" class="mt-sm w-full bg-primary text-on-primary py-sm px-md rounded font-label-lg text-label-lg hover:opacity-90 transition-colors flex items-center justify-center gap-sm" type="button" onclick="sendOTP()">
<span class="">Send OTP</span>
<span class="material-symbols-outlined text-[18px]">arrow_forward</span>
</button>
</div>

<!-- OTP Input Field -->
<div class="flex flex-col gap-xs hidden" id="otp-container">
<label class="font-label-sm text-label-sm text-on-surface-variant flex justify-between" for="otp">
<span class="">One-Time Password</span>
<span class="text-secondary cursor-pointer hover:underline" onclick="sendOTP()">Resend</span>
</label>
<div class="flex gap-sm justify-between">
<input class="otp-input w-12 h-14 text-center rounded border border-outline-variant bg-surface-container-lowest font-headline-md text-headline-md text-on-surface focus:border-secondary focus:ring-2 focus:ring-secondary/20 transition-colors" maxlength="1" type="text"/>
<input class="otp-input w-12 h-14 text-center rounded border border-outline-variant bg-surface-container-lowest font-headline-md text-headline-md text-on-surface focus:border-secondary focus:ring-2 focus:ring-secondary/20 transition-colors" maxlength="1" type="text"/>
<input class="otp-input w-12 h-14 text-center rounded border border-outline-variant bg-surface-container-lowest font-headline-md text-headline-md text-on-surface focus:border-secondary focus:ring-2 focus:ring-secondary/20 transition-colors" maxlength="1" type="text"/>
<input class="otp-input w-12 h-14 text-center rounded border border-outline-variant bg-surface-container-lowest font-headline-md text-headline-md text-on-surface focus:border-secondary focus:ring-2 focus:ring-secondary/20 transition-colors" maxlength="1" type="text"/>
<input class="otp-input w-12 h-14 text-center rounded border border-outline-variant bg-surface-container-lowest font-headline-md text-headline-md text-on-surface focus:border-secondary focus:ring-2 focus:ring-secondary/20 transition-colors" maxlength="1" type="text"/>
<input class="otp-input w-12 h-14 text-center rounded border border-outline-variant bg-surface-container-lowest font-headline-md text-headline-md text-on-surface focus:border-secondary focus:ring-2 focus:ring-secondary/20 transition-colors" maxlength="1" type="text"/>
</div>
<button id="verify-otp-btn" class="mt-sm w-full bg-primary text-on-primary py-sm px-md rounded font-label-lg text-label-lg hover:opacity-90 transition-colors flex items-center justify-center gap-sm" type="button" onclick="verifyOTP()">
<span class="">Verify OTP & Login</span>
<span class="material-symbols-outlined text-[18px]">login</span>
</button>
</div>
<div id="error-msg" class="text-error text-center mt-2 hidden text-sm"></div>
</form>

<!-- Footer Links -->
<div class="mt-xl flex flex-col items-center gap-sm pt-md border-t border-outline-variant/20">
<img alt="Scalland" class="h-8 opacity-60 mb-sm dark:hidden" src="./static/img/scalland_final_logo.svg"/>
<img alt="Scalland" class="h-8 opacity-60 mb-sm hidden dark:block" src="./static/img/scalland_final_logo_dark.svg"/>
<p class="font-body-sm text-body-sm text-on-surface-variant text-center">
                Need help accessing your account? <br/> Contact your IT administrator.
            </p>
</div>
</div>
</main>
<script>
    const otpInputs = document.querySelectorAll('.otp-input');
    otpInputs.forEach((input, index) => {
        input.addEventListener('input', (e) => {
            if (e.target.value && index < otpInputs.length - 1) {
                otpInputs[index + 1].focus();
            }
        });
        input.addEventListener('keydown', (e) => {
            if (e.key === 'Backspace' && !e.target.value && index > 0) {
                otpInputs[index - 1].focus();
            }
        });
    });

    async function sendOTP() {
        const email = document.getElementById('email').value;
        const errorMsg = document.getElementById('error-msg');
        if (!email) {
            errorMsg.textContent = "Email is required";
            errorMsg.classList.remove('hidden');
            return;
        }
        document.getElementById('send-otp-btn').innerText = "Sending...";
        try {
            const res = await fetch('/api/v1/auth/send-otp', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ email })
            });
            const data = await res.json();
            if (!res.ok) throw new Error(data.error || "Failed to send OTP");
            document.getElementById('email-container').classList.add('hidden');
            document.getElementById('otp-container').classList.remove('hidden');
            errorMsg.classList.add('hidden');
            otpInputs[0].focus();
        } catch (e) {
            errorMsg.textContent = e.message;
            errorMsg.classList.remove('hidden');
            document.getElementById('send-otp-btn').innerHTML = `<span class="">Send OTP</span><span class="material-symbols-outlined text-[18px]">arrow_forward</span>`;
        }
    }

    async function verifyOTP() {
        const email = document.getElementById('email').value;
        let otp = '';
        otpInputs.forEach(i => otp += i.value);
        const errorMsg = document.getElementById('error-msg');
        if (otp.length < 6) {
            errorMsg.textContent = "Enter complete OTP";
            errorMsg.classList.remove('hidden');
            return;
        }
        document.getElementById('verify-otp-btn').innerText = "Verifying...";
        try {
            const res = await fetch('/api/v1/auth/verify-otp', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ email, otp })
            });
            const data = await res.json();
            if (!res.ok) throw new Error(data.error || "Failed to verify OTP");
            window.location.href = '/dashboard';
        } catch (e) {
            errorMsg.textContent = e.message;
            errorMsg.classList.remove('hidden');
            document.getElementById('verify-otp-btn').innerHTML = `<span class="">Verify OTP & Login</span><span class="material-symbols-outlined text-[18px]">login</span>`;
        }
    }
</script>
{{end}}
