{{define "body_classes"}}bg-background text-on-background antialiased pt-20{{end}}
{{define "header_block"}}{{template "navbar" .}}{{end}}
{{define "content"}}
<main class="max-w-[1440px] mx-auto px-margin-mobile md:px-margin-desktop py-xl">
<!-- Hero Section -->
<section class="mb-xl text-center md:text-left">
<h1 class="font-display-lg-mobile md:font-display-lg text-primary mb-sm">Get in Touch</h1>
<p class="font-body-lg text-body-lg text-on-surface-variant max-w-2xl">Connect with Scalland's consulting experts to discuss how we can drive your enterprise forward. We are ready to listen and architect your next competitive advantage.</p>
</section>
<!-- Main Content Bento Grid -->
<div class="grid grid-cols-1 md:grid-cols-12 gap-gutter">
<!-- Contact Form Area (Spans 7 columns) -->
<div class="md:col-span-7 bg-surface-container-lowest rounded-lg enterprise-shadow p-lg">
<h2 class="font-headline-md text-headline-md text-primary mb-lg">Book a Consultation</h2>
<form class="space-y-md">
<div class="grid grid-cols-1 md:grid-cols-2 gap-md">
<div>
<label class="block font-label-sm text-label-sm text-on-surface-variant mb-xs" for="firstName">First Name</label>
<input class="w-full bg-surface-container-lowest border border-outline-variant rounded px-4 py-3 font-body-md text-body-md text-on-surface focus:border-secondary focus:ring-2 focus:ring-secondary/20 transition-all outline-none" id="firstName" placeholder="Jane" type="text"/>
</div>
<div>
<label class="block font-label-sm text-label-sm text-on-surface-variant mb-xs" for="lastName">Last Name</label>
<input class="w-full bg-surface-container-lowest border border-outline-variant rounded px-4 py-3 font-body-md text-body-md text-on-surface focus:border-secondary focus:ring-2 focus:ring-secondary/20 transition-all outline-none" id="lastName" placeholder="Doe" type="text"/>
</div>
</div>
<div>
<label class="block font-label-sm text-label-sm text-on-surface-variant mb-xs" for="email">Corporate Email</label>
<input class="w-full bg-surface-container-lowest border border-outline-variant rounded px-4 py-3 font-body-md text-body-md text-on-surface focus:border-secondary focus:ring-2 focus:ring-secondary/20 transition-all outline-none" id="email" placeholder="jane.doe@company.com" type="email"/>
</div>
<div>
<label class="block font-label-sm text-label-sm text-on-surface-variant mb-xs" for="company">Company Name</label>
<input class="w-full bg-surface-container-lowest border border-outline-variant rounded px-4 py-3 font-body-md text-body-md text-on-surface focus:border-secondary focus:ring-2 focus:ring-secondary/20 transition-all outline-none" id="company" placeholder="Acme Corp" type="text"/>
</div>
<div>
<label class="block font-label-sm text-label-sm text-on-surface-variant mb-xs" for="inquiryType">Inquiry Type</label>
<select class="w-full bg-surface-container-lowest border border-outline-variant rounded px-4 py-3 font-body-md text-body-md text-on-surface focus:border-secondary focus:ring-2 focus:ring-secondary/20 transition-all outline-none appearance-none" id="inquiryType">
<option value="">Select an area of interest</option>
<option value="strategy">Strategic Consulting</option>
<option value="tech">Technology Implementation</option>
<option value="operations">Operational Efficiency</option>
<option value="other">Other</option>
</select>
</div>
<div>
<label class="block font-label-sm text-label-sm text-on-surface-variant mb-xs" for="message">Message</label>
<textarea class="w-full bg-surface-container-lowest border border-outline-variant rounded px-4 py-3 font-body-md text-body-md text-on-surface focus:border-secondary focus:ring-2 focus:ring-secondary/20 transition-all outline-none resize-none" id="message" placeholder="How can we help you achieve your goals?" rows="4"></textarea>
</div>
<button class="w-full md:w-auto gradient-primary text-white font-label-lg text-label-lg px-xl py-4 rounded hover:opacity-90 transition-opacity flex items-center justify-center gap-2" type="submit">
<span>Submit Request</span>
<span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">arrow_forward</span>
</button>
</form>
</div>
<!-- Contact Info & Map Area (Spans 5 columns) -->
<div class="md:col-span-5 flex flex-col gap-gutter">
<!-- Contact Details Card -->
<div class="bg-surface-container-lowest rounded-lg enterprise-shadow p-lg border-t-4 border-secondary">
<h3 class="font-headline-md text-headline-md text-primary mb-md">Global Headquarters</h3>
<div class="space-y-sm">
<div class="flex items-start gap-sm">
<span class="material-symbols-outlined text-secondary mt-1">location_on</span>
<div>
<p class="font-body-md text-body-md text-on-surface">Scalland Consultancy Services</p>
<p class="font-body-md text-body-md text-on-surface-variant">A106, MC Sarovar, Medahalli, KR Puram,</p>
<p class="font-body-md text-body-md text-on-surface-variant">Bangalore - 560049</p>
</div>
</div>
<div class="flex items-center gap-sm mt-md">
<span class="material-symbols-outlined text-secondary">mail</span>
<a class="font-body-md text-body-md text-on-surface hover:text-secondary transition-colors" href="mailto:hello@scalland.com">hello@scalland.com</a>
</div>

</div>
</div>
<!-- Global Connectivity Visualization -->
<div class="bg-primary-container rounded-lg h-64 w-full relative overflow-hidden enterprise-shadow group">
<img alt="Global Digital Connectivity Network" class="absolute inset-0 w-full h-full object-cover opacity-80 group-hover:scale-105 transition-transform duration-700 ease-in-out" src="./static/img/global_connectivity.png"/>
<!-- Overlay Content -->
<div class="absolute inset-0 bg-gradient-to-t from-primary-container/90 via-primary-container/40 to-transparent flex flex-col justify-end p-lg">
<div class="flex items-center gap-sm mb-xs">
<span class="material-symbols-outlined text-secondary">public</span>
<span class="font-label-sm text-label-sm text-secondary uppercase tracking-wider">Global Reach</span>
</div>
<h4 class="font-headline-md text-headline-md text-white">Architecting the Future</h4>
<p class="font-body-sm text-body-sm text-primary-fixed-dim max-w-sm mt-xs">Connecting enterprises worldwide through digital excellence.</p>
</div>
</div>
</div>
</div>
</main>
{{end}}
