{{define "header_block"}}{{template "navbar" .}}{{end}}
{{define "content"}}
<main class="flex-grow">
<!-- Hero Section -->
<section class="w-full max-w-[1440px] mx-auto px-margin-mobile md:px-margin-desktop py-xl md:py-[120px] grid grid-cols-1 md:grid-cols-12 gap-gutter items-center">
<div class="md:col-span-7 flex flex-col gap-lg z-10">
<h1 class="font-display-lg-mobile md:font-display-lg text-display-lg-mobile md:text-display-lg text-primary">
                    Strategic Cloud Orchestration
                </h1>
<p class="font-body-lg text-body-lg text-on-surface-variant max-w-2xl">
                    Architecting scalable, resilient infrastructure for the modern enterprise. We translate complex technical requirements into streamlined, future-proof business solutions.
                </p>
<div class="flex flex-wrap gap-md mt-sm">
<button class="font-label-lg text-label-lg bg-primary text-white px-xl py-sm rounded bg-gradient-to-b from-[#0A192F] to-[#003B5C] hover:opacity-90 transition-opacity shadow-lg">
                        Get Started
                    </button>
<button class="font-label-lg text-label-lg text-primary border-2 border-primary px-xl py-sm rounded hover:bg-surface-container-low transition-colors">
                        Learn More
                    </button>
</div>
</div>
<div class="md:col-span-5 relative h-[400px] md:h-[600px] rounded-xl overflow-hidden shadow-[0_12px_32px_rgba(10,25,47,0.12)]">
<img alt="Cloud Architecture Visualization" class="w-full h-full object-cover" data-alt="A modern, high-tech corporate office environment featuring abstract digital displays visualizing cloud architecture and data flow. The scene is illuminated with crisp, cool white lighting and subtle electric blue accents, reflecting a premium, enterprise consultancy aesthetic. The overall mood is precise, innovative, and highly professional." src="./static/img/index_hero.jpg"/>
<div class="absolute inset-0 bg-gradient-to-t from-primary-container/80 to-transparent"></div>
</div>
</section>
<!-- Services Bento Grid -->
<section class="w-full max-w-[1440px] mx-auto px-margin-mobile md:px-margin-desktop py-xl bg-surface-container-low">
<div class="mb-xl text-center max-w-3xl mx-auto">
<h2 class="font-headline-lg text-headline-lg text-primary mb-md">Enterprise Capabilities</h2>
<p class="font-body-md text-body-md text-on-surface-variant">Delivering structural integrity and technological agility across key business verticals.</p>
</div>
<div class="grid grid-cols-1 md:grid-cols-12 gap-gutter">
<!-- Cloud Card -->
<div class="md:col-span-8 bg-surface rounded-lg p-lg shadow-[0_4px_16px_rgba(10,25,47,0.06)] border-t-4 border-[#007BFF] relative overflow-hidden flex flex-col justify-between min-h-[300px]">
<div class="z-10 relative">
<span class="material-symbols-outlined text-[48px] text-[#007BFF] mb-sm" data-icon="cloud_sync" style='font-variation-settings: "FILL" 1;'>cloud_sync</span>
<h3 class="font-headline-md text-headline-md text-primary mb-sm">Cloud Orchestration</h3>
<p class="font-body-md text-body-md text-on-surface-variant max-w-md">
                            Seamless migration, multi-cloud strategy, and continuous optimization. We build architectures that scale dynamically while maintaining rigorous security postures.
                        </p>
</div>
<div class="absolute bottom-0 right-0 w-64 h-64 bg-primary-container/5 rounded-tl-full -mr-16 -mb-16"></div>
</div>
<!-- App Dev Card -->
<div class="md:col-span-4 bg-surface rounded-lg p-lg shadow-[0_4px_16px_rgba(10,25,47,0.06)] flex flex-col min-h-[300px]">
<span class="material-symbols-outlined text-[40px] text-primary mb-sm" data-icon="code_blocks" style='font-variation-settings: "FILL" 1;'>code_blocks</span>
<h3 class="font-headline-md text-headline-md text-primary mb-sm">Application Development</h3>
<p class="font-body-md text-body-md text-on-surface-variant flex-grow">
                        Bespoke enterprise software engineering leveraging modern frameworks for high-performance, maintainable systems.
                    </p>
<button class="font-label-sm text-label-sm text-[#007BFF] uppercase tracking-wider mt-md text-left flex items-center gap-xs hover:underline">
                        Explore Dev <span class="material-symbols-outlined text-[16px]" data-icon="arrow_forward">arrow_forward</span>
</button>
</div>
<!-- Brand Strategy Card -->
<div class="md:col-span-12 bg-surface rounded-lg p-lg shadow-[0_4px_16px_rgba(10,25,47,0.06)] grid grid-cols-1 md:grid-cols-2 gap-lg items-center">
<div>
<span class="material-symbols-outlined text-[40px] text-primary mb-sm" data-icon="strategy" style='font-variation-settings: "FILL" 1;'>strategy</span>
<h3 class="font-headline-md text-headline-md text-primary mb-sm">Digital Brand Strategy</h3>
<p class="font-body-md text-body-md text-on-surface-variant mb-md">
                            Aligning your technological capabilities with market positioning. We craft comprehensive digital identities that communicate authority and innovation to your stakeholders.
                        </p>
<div class="flex gap-sm">
<span class="bg-surface-container-highest dark:bg-white/5 text-primary px-sm py-xs rounded font-label-sm text-label-sm">Market Analysis</span>
<span class="bg-surface-container-highest dark:bg-white/5 text-primary px-sm py-xs rounded font-label-sm text-label-sm">Positioning</span>
</div>
</div>
<div class="h-[200px] rounded bg-surface-container-high relative overflow-hidden">
<img alt="Data Analytics Visualization" class="w-full h-full object-cover" data-alt="A clean, minimalist presentation of strategic business charts and graphs displayed on a sleek modern tablet device resting on a pristine white desk. The lighting is soft and diffused, emphasizing a corporate, data-driven environment with a focus on clear metrics and professional brand strategy." src="./static/img/index_analytics.jpg"/>
</div>
</div>
</div>
</section>
</main>
{{end}}
