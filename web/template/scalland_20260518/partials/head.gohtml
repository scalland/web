{{define "head"}}
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>Scalland Consultancy Services</title>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-25..0" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&amp;display=swap" rel="stylesheet"/>
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "inverse-surface": "var(--color-inverse-surface)",
                        "surface-container-high": "var(--color-surface-container-high)",
                        "on-primary-container": "var(--color-on-primary-container)",
                        "secondary-fixed-dim": "var(--color-secondary-fixed-dim)",
                        "on-tertiary-fixed": "var(--color-on-tertiary-fixed)",
                        "on-error": "var(--color-on-error)",
                        "secondary-container": "var(--color-secondary-container)",
                        primary: "var(--color-primary)",
                        "secondary-fixed": "var(--color-secondary-fixed)",
                        "surface-container-low": "var(--color-surface-container-low)",
                        "inverse-on-surface": "var(--color-inverse-on-surface)",
                        "on-secondary-fixed-variant": "var(--color-on-secondary-fixed-variant)",
                        surface: "var(--color-surface)",
                        "tertiary-fixed-dim": "var(--color-tertiary-fixed-dim)",
                        "surface-tint": "var(--color-surface-tint)",
                        outline: "var(--color-outline)",
                        "tertiary-fixed": "var(--color-tertiary-fixed)",
                        "tertiary-container": "var(--color-tertiary-container)",
                        "on-surface": "var(--color-on-surface)",
                        "surface-dim": "var(--color-surface-dim)",
                        "primary-container": "var(--color-primary-container)",
                        "primary-fixed-dim": "var(--color-primary-fixed-dim)",
                        secondary: "var(--color-secondary)",
                        "on-primary": "var(--color-on-primary)",
                        "surface-container-lowest": "var(--color-surface-container-lowest)",
                        background: "var(--color-background)",
                        "surface-container-highest": "var(--color-surface-container-highest)",
                        tertiary: "var(--color-tertiary)",
                        "surface-variant": "var(--color-surface-variant)",
                        "on-primary-fixed": "var(--color-on-primary-fixed)",
                        "on-secondary": "var(--color-on-secondary)",
                        "on-tertiary-container": "var(--color-on-tertiary-container)",
                        "on-tertiary-fixed-variant": "var(--color-on-tertiary-fixed-variant)",
                        "inverse-primary": "var(--color-inverse-primary)",
                        "surface-container": "var(--color-surface-container)",
                        "on-tertiary": "var(--color-on-tertiary)",
                        error: "var(--color-error)",
                        "outline-variant": "var(--color-outline-variant)",
                        "surface-bright": "var(--color-surface-bright)",
                        "on-background": "var(--color-on-background)",
                        "on-surface-variant": "var(--color-on-surface-variant)",
                        "error-container": "var(--color-error-container)",
                        "on-error-container": "var(--color-on-error-container)",
                        "on-primary-fixed-variant": "var(--color-on-primary-fixed-variant)",
                        "on-secondary-container": "var(--color-on-secondary-container)",
                        "on-secondary-fixed": "var(--color-on-secondary-fixed)",
                        "primary-fixed": "var(--color-primary-fixed)"
                    },
                    borderRadius: {
                        DEFAULT: "0.25rem",
                        lg: "0.5rem",
                        xl: "0.75rem",
                        full: "9999px"
                    },
                    spacing: {
                        lg: "48px",
                        xl: "80px",
                        xs: "4px",
                        sm: "12px",
                        gutter: "24px",
                        md: "24px",
                        "margin-desktop": "64px",
                        base: "8px",
                        "margin-mobile": "16px"
                    },
                    fontFamily: {
                        "headline-md": ["Plus Jakarta Sans"],
                        "body-md": ["Plus Jakarta Sans"],
                        "label-sm": ["Plus Jakarta Sans"],
                        "display-lg": ["Plus Jakarta Sans"],
                        "body-lg": ["Plus Jakarta Sans"],
                        "display-lg-mobile": ["Plus Jakarta Sans"],
                        "body-sm": ["Plus Jakarta Sans"],
                        "label-lg": ["Plus Jakarta Sans"],
                        "headline-lg": ["Plus Jakarta Sans"],
                        headline: ["Plus Jakarta Sans"],
                        display: ["Plus Jakarta Sans"],
                        body: ["Plus Jakarta Sans"],
                        label: ["Plus Jakarta Sans"]
                    },
                    fontSize: {
                        "headline-md": ["24px", {
                            lineHeight: "1.3",
                            fontWeight: "600"
                        }],
                        "body-md": ["16px", {
                            lineHeight: "1.6",
                            fontWeight: "400"
                        }],
                        "label-sm": ["12px", {
                            lineHeight: "1",
                            fontWeight: "500"
                        }],
                        "display-lg": ["48px", {
                            lineHeight: "1.1",
                            letterSpacing: "-0.02em",
                            fontWeight: "700"
                        }],
                        "body-lg": ["18px", {
                            lineHeight: "1.6",
                            fontWeight: "400"
                        }],
                        "display-lg-mobile": ["36px", {
                            lineHeight: "1.2",
                            fontWeight: "700"
                        }],
                        "body-sm": ["14px", {
                            lineHeight: "1.5",
                            fontWeight: "400"
                        }],
                        "label-lg": ["14px", {
                            lineHeight: "1",
                            letterSpacing: "0.05em",
                            fontWeight: "600"
                        }],
                        "headline-lg": ["32px", {
                            lineHeight: "1.2",
                            fontWeight: "600"
                        }]
                    }
                }
            }
        };
    </script>
<style>
  :root { --color-inverse-surface: #2f3131; --color-surface-container-high: #e8e8e8; --color-on-primary-container: #76849f; --color-secondary-fixed-dim: #adc7ff; --color-on-tertiary-fixed: #001d31; --color-on-error: #ffffff; --color-secondary-container: #0070ea; --color-primary: #000000; --color-secondary-fixed: #d8e2ff; --color-surface-container-low: #f3f3f3; --color-inverse-on-surface: #f1f1f1; --color-on-secondary-fixed-variant: #004493; --color-surface: #f9f9f9; --color-tertiary-fixed-dim: #a0cbf3; --color-surface-tint: #515f78; --color-outline: #75777e; --color-tertiary-fixed: #cce5ff; --color-tertiary-container: #001d31; --color-on-surface: #1a1c1c; --color-surface-dim: #dadada; --color-primary-container: #0d1c32; --color-primary-fixed-dim: #b9c7e4; --color-secondary: #0059bb; --color-on-primary: #ffffff; --color-surface-container-lowest: #ffffff; --color-background: #f9f9f9; --color-surface-container-highest: #e2e2e2; --color-tertiary: #000000; --color-surface-variant: #e2e2e2; --color-on-primary-fixed: #0d1c32; --color-on-secondary: #ffffff; --color-on-tertiary-container: #5d88ad; --color-on-tertiary-fixed-variant: #1a4a6c; --color-inverse-primary: #b9c7e4; --color-surface-container: #eeeeee; --color-on-tertiary: #ffffff; --color-error: #ba1a1a; --color-outline-variant: #c5c6cd; --color-surface-bright: #f9f9f9; --color-on-background: #1a1c1c; --color-on-surface-variant: #44474d; --color-error-container: #ffdad6; --color-on-error-container: #93000a; --color-on-primary-fixed-variant: #39475f; --color-on-secondary-container: #fefcff; --color-on-secondary-fixed: #001a41; --color-primary-fixed: #d6e3ff; }
  .dark { --color-inverse-surface: #e2e2e2; --color-surface-container-high: #282a2b; --color-on-primary-container: #74829d; --color-secondary-fixed-dim: #adc7ff; --color-on-tertiary-fixed: #001d31; --color-on-error: #690005; --color-secondary-container: #4a8eff; --color-primary: #b9c7e4; --color-secondary-fixed: #d8e2ff; --color-surface-container-low: #1a1c1c; --color-inverse-on-surface: #2f3131; --color-on-secondary-fixed-variant: #004493; --color-surface: #121414; --color-tertiary-fixed-dim: #a0cbf3; --color-surface-tint: #b9c7e4; --color-outline: #8f9097; --color-tertiary-fixed: #cce5ff; --color-tertiary-container: #001b2d; --color-on-surface: #e2e2e2; --color-surface-dim: #121414; --color-primary-container: #0a192f; --color-primary-fixed-dim: #b9c7e4; --color-secondary: #adc7ff; --color-on-primary: #233148; --color-surface-container-lowest: #0c0f0f; --color-background: #121414; --color-surface-container-highest: #333535; --color-tertiary: #a0cbf3; --color-surface-variant: #333535; --color-on-primary-fixed: #0d1c32; --color-on-secondary: #002e68; --color-on-tertiary-container: #5b86ab; --color-on-tertiary-fixed-variant: #1a4a6c; --color-inverse-primary: #515f78; --color-surface-container: #1e2020; --color-on-tertiary: #003351; --color-error: #ffb4ab; --color-outline-variant: #44474d; --color-surface-bright: #38393a; --color-on-background: #e2e2e2; --color-on-surface-variant: #c5c6cd; --color-error-container: #93000a; --color-on-error-container: #ffdad6; --color-on-primary-fixed-variant: #39475f; --color-on-secondary-container: #00285b; --color-on-secondary-fixed: #001a41; --color-primary-fixed: #d6e3ff; }
</style>
<script>
  if (localStorage.getItem('color-theme') === 'dark' || (!('color-theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) { document.documentElement.classList.add('dark'); } else { document.documentElement.classList.remove('dark'); }
</script>

{{end}}